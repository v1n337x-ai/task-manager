# Production Docker build context — keep tests, local data, and secrets out.
# The builder only needs: app/, components/, lib/, prisma/, public/,
# scripts/ (PST worker), *.ts/*.mjs/*.json config, package*.json.
# NOTE: prisma/templates/*.xlsx/*.pptx are runtime templates — never exclude prisma/.
.next/
node_modules/
out/
build/
coverage/
.vitest/
storage/
tests/
.git/
.github/
.env
.env.*
!.env.example
*.log
*cookies*.txt
/*.eml
/*.pst
/*.xlsx
/*.pptx
/*.pdf
.dockerignore
Dockerfile
