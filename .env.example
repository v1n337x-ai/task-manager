# ─────────────────────────────────────────────────────────────────────────────
# Task Manager — environment template. Copy to `.env` and fill real values.
# NEVER commit `.env` / `.env.*` (except this example file).
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL 16 connection string (Prisma).
DATABASE_URL="postgresql://task_manager:CHANGE_ME@localhost:5432/task_manager?schema=public"

# Session signing secret (HS256, jose). Generate: openssl rand -base64 48
AUTH_SECRET="GENERATE_A_RANDOM_64_BYTE_SECRET"

# Application secret — passphrase-bound cookie/domain context for rollback safety.
APPLICATION_SECRET="GENERATE_A_SECOND_RANDOM_64_BYTE_SECRET"

# Dedicated secret for AES-256-GCM encryption of stored AI API keys (Phase 2.1).
# MUST be different from AUTH_SECRET / APPLICATION_SECRET.
APP_ENCRYPTION_KEY="GENERATE_A_THIRD_RANDOM_64_BYTE_SECRET"

# EML ingestion (Phase 4)
MAX_EML_SIZE_MB="10"
EML_STORAGE_ROOT="storage/eml"

# Runtime environment controls cookie `Secure` flag and log verbosity.
# Allowed: development | test | production
NODE_ENV="development"

# Login rate limiting (attempts per window) — practical brute-force protection.
LOGIN_RATE_LIMIT_MAX="5"
LOGIN_RATE_LIMIT_WINDOW_SECONDS="60"

# Session lifetime in seconds (default 12h).
SESSION_TTL_SECONDS="43200"

# Development seed credentials (used ONLY by `npm run db:seed`).
SEED_ADMIN_EMAIL="admin@akasaair.com"
SEED_ADMIN_PASSWORD="CHANGE_ME_MIN_10_CHARS"

# Public, non-secret display metadata (safe for client bundling).
NEXT_PUBLIC_APP_NAME="Task Manager"
NEXT_PUBLIC_APP_TAGLINE="VAPT"
